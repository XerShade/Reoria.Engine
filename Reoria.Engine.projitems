    <Compile Include="$(MSBuildThisFileDirectory)Common\Security\Cryptography\Interfaces\ISaltGenerator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Security\Cryptography\SaltGeneratorConfiguration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Security\Cryptography\SaltGenerator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Security\Encryption\AesEncryption.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\TimeAccumulator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\TimeAccumulatorConfiguration.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Container\Configuration\EngineConfigurationProvider.cs" />

    <Compile Include="$(MSBuildThisFileDirectory)Container\Logging\MicrosoftLoggingInitializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Container\Logging\Interfaces\ILoggingInitializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Container\Logging\SerilogLoggingInitializer.cs" />
